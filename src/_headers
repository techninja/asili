# Vendored/compiled assets — only change on explicit re-vendor, safe to cache forever
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/deps/*
  Cache-Control: public, max-age=31536000, immutable

# App JS/CSS — must-revalidate so browsers always check on new deploys
# CF returns 304 instantly when unchanged, new content when updated
/pages/*
  Cache-Control: public, max-age=0, must-revalidate

/components/*
  Cache-Control: public, max-age=0, must-revalidate

/utils/*
  Cache-Control: public, max-age=0, must-revalidate

/router/*
  Cache-Control: public, max-age=0, must-revalidate

/store/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate

/locales/*
  Cache-Control: public, max-age=0, must-revalidate

/icons.json
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
