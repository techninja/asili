# Vendored/compiled assets — only change on explicit re-vendor, safe to cache forever
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/deps/*
  Cache-Control: public, max-age=31536000, immutable

# App JS/CSS — no-cache so CF edge doesn't serve stale files after deploys
# Browser and CF both revalidate via ETag on every request (304 when unchanged)
/pages/*
  Cache-Control: no-cache

/components/*
  Cache-Control: no-cache

/utils/*
  Cache-Control: no-cache

/router/*
  Cache-Control: no-cache

/store/*
  Cache-Control: no-cache

/styles/*
  Cache-Control: no-cache

/locales/*
  Cache-Control: no-cache

/icons.json
  Cache-Control: public, max-age=86400

/logo.svg
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
